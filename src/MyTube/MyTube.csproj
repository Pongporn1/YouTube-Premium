<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Branding\MyTube.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Scripts\cosmetic-filter.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Styles\cosmetic-filter.css"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Filters\default-filters.txt"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Branding\MyTube.ico"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
