<Window x:Class="MyTube.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MyTube Premium"
        Width="1280"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing"
        Closed="OnClosed">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="#15181E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,6,0" VerticalAlignment="Center">
                    <Image x:Name="TitleIcon" Width="18" Height="18" />
                    <TextBlock x:Name="TitleText"
                               Text="MyTube Premium"
                               Margin="9,0,0,0"
                               Foreground="#B8BEC9"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="NavStack" Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#x2190;"
                            Command="{Binding BackCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Back (Alt+Left)" />
                    <Button Content="&#x2192;"
                            Command="{Binding ForwardCommand}"
                            IsEnabled="{Binding CanGoForward}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Forward (Alt+Right)" />
                    <Button Content="&#x27F3;"
                            Command="{Binding ReloadCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Reload (Ctrl+R)" />
                    <Button Content="&#x2302;"
                            Command="{Binding HomeCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="YouTube Home" />
                    <Button Content="&#x266B;"
                            Click="OnMusicClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="MyTube Music window" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MiniPlayerButton"
                            Content="&#x29C9;"
                            Click="OnMiniPlayerClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Mini player always on top (Ctrl+Shift+M)" />
                    <Button x:Name="SettingsButton"
                            Content="&#x2699;"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Settings" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#x2500;"
                            Click="OnMinimizeWindowClick"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton"
                            Content="&#x25A1;"
                            Click="OnMaximizeRestoreClick"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="Maximize / Restore" />
                    <Button Content="&#x2715;"
                            Click="OnCloseWindowClick"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="BrowserHost" Grid.Row="1" Background="#0F1115">
            <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#0F1115" />
            <Border x:Name="LoadingPanel" Background="#111318">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,16,0,0"
                               Text="Starting YouTube..."
                               Foreground="#D9DCE3"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="ConnectionErrorPanel"
                    Background="#111318"
                    Visibility="Collapsed">
                <StackPanel Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Unable to connect to YouTube"
                               Foreground="#F4F5F7"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,20"
                               Text="Check your internet connection and try again."
                               Foreground="#B8BEC9"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <Button Width="100"
                            Height="36"
                            HorizontalAlignment="Center"
                            Content="Retry"
                            Click="OnRetry" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
