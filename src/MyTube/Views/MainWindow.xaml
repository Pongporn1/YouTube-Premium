<Window x:Class="MyTube.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MyTube"
        Width="1280"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing"
        Closed="OnClosed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Toolbar" Grid.Row="0" Background="{StaticResource ToolbarBrush}">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&#x2190;"
                        Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Back (Alt+Left)" />
                <Button Grid.Column="1"
                        Content="&#x2192;"
                        Command="{Binding ForwardCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Forward (Alt+Right)" />
                <Button Grid.Column="2"
                        Content="&#x27F3;"
                        Command="{Binding ReloadCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Reload (Ctrl+R)" />
                <Button Grid.Column="3"
                        Content="&#x2302;"
                        Command="{Binding HomeCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="YouTube Home" />

                <TextBlock Grid.Column="4"
                           Text="MyTube"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Button Grid.Column="5"
                        Content="&#x2699;"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Settings" />
            </Grid>
        </Border>

        <Grid x:Name="BrowserHost" Grid.Row="1" Background="#0F1115">
            <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#0F1115" />
            <Border x:Name="LoadingPanel" Background="#111318">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                    <TextBlock Margin="0,16,0,0"
                               Text="Starting YouTube..."
                               Foreground="#D9DCE3"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="ConnectionErrorPanel"
                    Background="#111318"
                    Visibility="Collapsed">
                <StackPanel Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Unable to connect to YouTube"
                               Foreground="#F4F5F7"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,20"
                               Text="Check your internet connection and try again."
                               Foreground="#B8BEC9"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <Button Width="100"
                            Height="36"
                            HorizontalAlignment="Center"
                            Content="Retry"
                            Click="OnRetry" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
