<Window x:Class="MyTube.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTube Settings"
        Width="560"
        Height="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#15181E"
        Foreground="#F4F5F7"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#E8EAF0" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="#F4F5F7" />
            <Setter Property="BorderBrush" Value="#3A3F49" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="MyTube Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Text="Local-only preferences. MyTube sends no telemetry."
                       Foreground="#AEB4C0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <GroupBox Header="General">
                    <StackPanel>
                        <CheckBox Content="Open YouTube on startup"
                                  IsChecked="{Binding Draft.OpenYouTubeOnStartup}" />
                        <CheckBox Content="Remember session"
                                  IsChecked="{Binding Draft.RememberSession}" />
                        <CheckBox Content="YouTube-only mode (required)"
                                  IsChecked="{Binding Draft.YouTubeOnlyMode}"
                                  IsEnabled="False"
                                  ToolTip="MyTube always restricts top-level navigation for security." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Content">
                    <StackPanel>
                        <CheckBox Content="Hide Shorts"
                                  IsChecked="{Binding Draft.HideShorts}" />
                        <CheckBox Content="Hide Home feed"
                                  IsChecked="{Binding Draft.HideHomeFeed}" />
                        <CheckBox Content="Hide recommendations"
                                  IsChecked="{Binding Draft.HideRecommendations}" />
                        <CheckBox Content="Hide comments"
                                  IsChecked="{Binding Draft.HideComments}" />
                        <CheckBox Content="Hide merch and promotional UI"
                                  IsChecked="{Binding Draft.HideMerch}" />
                        <CheckBox Content="Hide sponsored cards in feeds (player ads are always blocked)"
                                  IsChecked="{Binding Draft.HidePromotions}" />
                        <CheckBox Content="Hide popups"
                                  IsChecked="{Binding Draft.HidePopups}" />
                        <CheckBox Content="Focus Mode"
                                  IsChecked="{Binding Draft.FocusMode}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Privacy">
                    <StackPanel>
                        <CheckBox Content="Enable content filtering"
                                  IsChecked="{Binding Draft.EnableContentFiltering}" />
                        <CheckBox Content="Block known trackers"
                                  IsChecked="{Binding Draft.BlockKnownTrackers}" />
                        <CheckBox Content="Clear cache on exit"
                                  IsChecked="{Binding Draft.ClearCacheOnExit}" />
                        <CheckBox Content="Clear cookies on exit"
                                  IsChecked="{Binding Draft.ClearCookiesOnExit}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Developer">
                    <StackPanel>
                        <CheckBox Content="Enable debug logging"
                                  IsChecked="{Binding Draft.EnableDebugLogging}" />
                        <CheckBox Content="Show WebView DevTools (Debug builds only)"
                                  IsChecked="{Binding Draft.EnableDevTools}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="About">
                    <TextBlock Text="MyTube is an independent personal browser wrapper. Not affiliated with Google or YouTube."
                               Foreground="#C5C9D2"
                               TextWrapping="Wrap" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    HorizontalAlignment="Left"
                    Content="Reset Defaults"
                    Command="{Binding ResetDefaultsCommand}"
                    Style="{StaticResource ActionButton}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource ActionButton}" />
                <Button Content="Save"
                        IsDefault="True"
                        Click="OnSave"
                        Style="{StaticResource ActionButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
