<Window x:Class="MyTube.Views.MusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MyTube Music"
        Width="480"
        Height="320"
        MinWidth="360"
        MinHeight="240"
        Background="#0F1115"
        WindowStartupLocation="Manual"
        Topmost="True"
        Loaded="OnLoaded"
        Closed="OnClosed"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#15181E" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="12,0"
                           Text="♫ MyTube Music — ลากแถบนี้เพื่อย้าย"
                           Foreground="#B8BEC9"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button x:Name="TopmostButton" Grid.Column="1"
                        Width="38"
                        Height="26"
                        Margin="0,0,4,0"
                        Content="&#x2691;"
                        Click="OnTopmostClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="สลับลอยด้านบนเสมอ" />
                <Button Grid.Column="2"
                        Width="34"
                        Height="26"
                        Margin="0,0,4,0"
                        Content="&#x2715;"
                        Click="OnCloseClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="ปิดหน้าต่างเพลง" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#0F1115">
            <wv2:WebView2 x:Name="Player" DefaultBackgroundColor="#0F1115" />
        </Grid>
    </Grid>
</Window>
