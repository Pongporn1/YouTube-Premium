<Window x:Class="MyTubeMusic.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MyTube Music"
        Width="440"
        Height="560"
        MinWidth="340"
        MinHeight="300"
        Background="#0F1115"
        WindowStartupLocation="Manual"
        Topmost="True"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closed="OnClosed"
        PreviewKeyDown="OnPreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#15181E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="12,0"
                           Text="♫ MyTube Music"
                           Foreground="#B8BEC9"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="TopmostButton"
                            Content="&#x2691;"
                            Click="OnTopmostClick"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="สลับลอยด้านบนเสมอ (เหนือเกม)" />
                    <Button Content="&#x2500;"
                            Click="OnMinimizeClick"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="พับจอ (ย่อลง taskbar)" />
                    <Button Content="&#x2715;"
                            Click="OnCloseClick"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            ToolTip="ปิด" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#0F1115">
            <wv2:WebView2 x:Name="Player" DefaultBackgroundColor="#0F1115" />
        </Grid>
    </Grid>
</Window>
