<Window x:Class="MyTubeMusic.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MyTube Music"
        Width="440"
        Height="560"
        MinWidth="340"
        MinHeight="300"
        Background="#0F1115"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closed="OnClosed"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#15181E" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="12,0"
                           Text="♫ MyTube Music — ลากย้ายได้"
                           Foreground="#B8BEC9"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button x:Name="TopmostButton" Grid.Column="1"
                        Content="&#x2691;"
                        Click="OnTopmostClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="สลับลอยด้านบนเสมอ (เหนือเกม)" />
                <Button Grid.Column="2"
                        Content="&#x2715;"
                        Click="OnCloseClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="ปิด" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#0F1115">
            <wv2:WebView2 x:Name="Player" DefaultBackgroundColor="#0F1115" />
        </Grid>
    </Grid>
</Window>
